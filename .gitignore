# ============================================================
# .gitignore - FinControl
# ============================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production builds
dist/
frontend/dist/
build/

# Environment variables & Deployment tokens
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
deploy_vercel.js

# Local database storage & user data files (do not ignore backend/src/data)
/data/
/backend/data/
backend/data/
!backend/src/data/
uploads/
backend/uploads/
DOCUMENTAÇÃO/

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
